flex-wrap:wrap;}.errorFileBlocked .errorHelpLinks, .errorFileMissing .errorHelpLinks{display:flex;}.errorFileBlocked .errorHelpLinks{justify-content:center;}@media (max-width:800px){ .errorFileMissing .errorHelpLinks{justify-content:center;}}.errorHelpLinks a{display:inline-flex;align-items:center;text-transform:uppercase;margin:8px 20px;font-size:.86rem;text-decoration:underline;}@media (max-width:600px){ .errorHelpLinks a:last-child{display:none;}}.errorHelpLinks span{height:20px;width:20px;margin-right:10px;background-image:url(//static.mediafire.com/images/icons/svg_light/icons_sprite.svg);background-repeat:no-repeat;}.errorFileBlocked .errorHelpLinks span{background-image:url(//static.mediafire.com/images/icons/svg_dark/icons_sprite.svg);}.errorHelpLinks .icon-homepage{background:url(//static.mediafire.com/images/icons/svg_light/home.svg) center;}.errorFileBlocked .errorHelpLinks .icon-homepage{background:url(//static.mediafire.com/images/icons/svg_dark/home.svg) center;}.errorHelpLinks .icon-support{background-position:-818px center;}.errorHelpLinks .icon-mobile{background-position:-890px center;}.MFinfo{display:none;padding:80px 0;text-align:center;}.errorFileBlocked .MFinfo, .errorFileMissing .MFinfo{display:block;}.MFinfo-leadIn{display:inline-flex;align-items:center;background:#F4F4F5;background:var(--mf-gray11);padding:10px 34px 10px 10px;border-radius:999px;color:#575B65;color:var(--mf-gray4);font-size:1.07rem;font-weight:bold;margin:0 30px 80px;}@media (max-width:450px){ .MFinfo-leadIn{padding-right:20px;font-size:.86rem;}}.MFinfo-leadIn span{display:block;height:40px;width:40px;background:url(//static.mediafire.com/images/backgrounds/error/arrows.svg) center 0/32px no-repeat, -webkit-linear-gradient(top, #45a9f9, #4585f9);background-color:#4585f9;border-radius:999em;margin-right:20px;flex-shrink:0;}@media (max-width:450px){ .MFinfo-leadIn span{margin-right:10px;}}.MFinfo-features{display:flex;flex-wrap:wrap;justify-content:center;}@media (max-width:768