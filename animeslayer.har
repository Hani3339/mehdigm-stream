olor:#222835;color:var(--mf-gray2);}.footerColWrap{display:flex;padding:30px 0;}@media (max-width:768px){ .footerColWrap{display:block;padding-bottom:10px;}}.footerCol{flex-basis:20%;}.footerCol h2{margin-top:0;margin-bottom:10px;font-size:.86rem;font-weight:bold;text-transform:uppercase;}.footerCol ul{list-style:none;margin:0;padding:0;}@media (max-width:768px){ .footerCol ul{display:flex;flex-wrap:wrap;margin-bottom:1rem;padding-bottom:1rem;border-bottom:1px solid rgba(0,0,0,.07)}.footerCol li{margin:10px 20px 10px 0;}}#subFooterWrap{box-shadow:0 -1px 0 0 hsla(225,5.9%,86.7%, .6);}#subFooter{display:flex;flex-wrap:wrap;align-items:center;padding:17px 0;font-size:.93rem;}.subFooterLinks{display:flex;flex-wrap:wrap;list-style:none;padding:0;margin:0 auto 0 0;}@media (max-width:768px){ .subFooterLinks{margin-bottom:1rem}}.subFooterLinks li{margin:10px 20px 10px 0;}#subFooterSocial{display:flex;align-items:flex-start;justify-content:center;list-style:none;margin:0;padding:0;}#subFooterSocial li{margin:0 3px;}.footerIcn a{display:block;position:relative;height:30px;width:30px;padding:0;border-radius:3px;background-color:rgba(0,0,0,0.1);overflow:hidden;}.footerIcn span{position:absolute;height:100%;width:100%;top:0;left:0;background-image:url(//static.mediafire.com/images/icons/svg_dark/social_icons_sprite.svg);background-repeat:no-repeat;background-size:auto 22px;cursor:pointer;opacity:.5;}.footerIcn a:hover span{background-image:url(//static.mediafire.com/images/icons/svg_light/social_icons_sprite.svg);opacity:1;}.footerIcnFb{background-position:4px 4px;}.footerIcnFb:hover{background-color:#1876f2;}.footerIcnTw{background-position:-23px 4px;}.footerIcnTw:hover{background-color:#1e9cf1;}.footerIcnBlog{background-position:-133px 4px;}.footerIcnBlog:hover{background-color:#f59638;}.sandboxLabel{display:none;position:fixed;left:5px;bottom:5px;z-index:50;box-shadow:0px 1px 2px 0px rgba(0,0,0,0.3);padding:5px 10px;font-size:10px;background-color:#000;color:#fff;border-radiu