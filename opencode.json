{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "model": "opencode/big-pickle",
  "small_model": "opencode/big-pickle",
  "default_agent": "build",
  "permission": {
    "*": "allow",
    "read": { "*": "allow" },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "doom_loop": "allow"
  },
  "agent": {
    "build": {
      "model": "opencode/big-pickle"
    }
  }
}
